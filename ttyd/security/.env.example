# --------------------------------------------------
# Application
# --------------------------------------------------
APP_ENV=
DEV_OFFLINE=

# --------------------------------------------------
# AWS
# --------------------------------------------------
AWS_REGION=
AWS_PROFILE=

# --------------------------------------------------
# Bedrock
# --------------------------------------------------
LLM_MODEL=
RAG_EMBED_MODEL_ID=
RAG_EMBED_DIM=

# --------------------------------------------------
# RAG / S3
# --------------------------------------------------
RAG_BUCKET=
RAG_KEY=
SQL_KEY=

# --------------------------------------------------
# Redshift / Lambda
# --------------------------------------------------
REDSHIFT_WORKGROUP_NAME=
REDSHIFT_ENDPOINT=
REDSHIFT_PORT=
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_HOST=
REDSHIFT_DB=
CLUSTER_ID=
REDSHIFT_LAMBDA_ARN=

USE_IAM_AUTH=
USE_SERVERLESS=

# --------------------------------------------------
# YAML metadata
# --------------------------------------------------
YAML_PATH_TABLES=
YAML_PATH_COL=

# --------------------------------------------------
# API v1 / Auth / DynamoDB
# --------------------------------------------------
JWT_SECRET=
JWT_ACCESS_EXPIRE_SECONDS=3600
JWT_REFRESH_EXPIRE_SECONDS=604800
DYNAMODB_ENDPOINT=
DYNAMODB_TABLE_PREFIX=ttyd
ASSISTANT_DISPLAY_NAME=RecordAI
CHAT_RATE_LIMIT_PER_MINUTE=30

# Microsoft Entra OAuth legado (preservado; paralelo ao SAML)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
APP_AUTH_MICROSOFT_TENANT_ID=
APP_AUTH_MICROSOFT_CLIENT_ID=
APP_AUTH_MICROSOFT_CLIENT_SECRET=

# SAML 2.0 — Record Entra ID (IdP) / TTYD (SP) — ver docs/SAML_AD_RECORD.md
APP_AUTH_SAML_ENABLED=false
APP_AUTH_SAML_SP_ENTITY_ID=http://localhost:8000/v1/auth/saml/metadata
APP_AUTH_SAML_SP_ACS_URL=http://localhost:8000/v1/auth/saml/callback
APP_AUTH_SAML_SP_SLO_URL=
APP_AUTH_SAML_IDP_ENTITY_ID=
APP_AUTH_SAML_IDP_SSO_URL=
APP_AUTH_SAML_IDP_CERT=
APP_AUTH_SAML_AUTO_PROVISION=true
APP_AUTH_SAML_DEFAULT_ROLE=ttyd:user
APP_AUTH_SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress
APP_AUTH_SAML_FRONTEND_LOGIN_URL=http://localhost:4200/login
