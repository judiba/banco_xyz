# [DEV] Environment: Offline/Mock
FROM python:3.12-slim

WORKDIR /app

# Instala dependências do sistema necessárias para compilação/ferramentas
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libxml2-dev \
    libxmlsec1-dev \
    libxmlsec1-openssl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml poetry.lock README.md ./
# Pacote declarado em pyproject.toml (backend/app) precisa existir antes do poetry install
COPY backend ./backend

# Instala Poetry e TODAS as dependências (incluindo dev e mock)
RUN pip install --no-cache-dir poetry==1.8.2 \
    && poetry config virtualenvs.create false \
    && poetry install --with dev,mock,database,vector,ingestion,memory --no-interaction --no-ansi

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
