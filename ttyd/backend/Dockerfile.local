# [LOCAL] Environment: AWS Real (Bedrock + RAG via Docker)
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libxml2-dev \
    libxmlsec1-dev \
    libxmlsec1-openssl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y ca-certificates
COPY Zscaler_Root_CA.pem /usr/local/share/ca-certificates/Zscaler_Root_CA.crt
RUN update-ca-certificates


COPY pyproject.toml poetry.lock README.md ./
COPY backend ./backend

# Strands/Bedrock (agentcore) + RAG (vector, ingestion, memory)
RUN pip install --no-cache-dir poetry==1.8.2 \
    && poetry config virtualenvs.create false \
    && poetry install \
        --without dev,mock \
        --with agentcore,memory,vector,ingestion,database \
        --no-interaction --no-ansi

ENV AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
