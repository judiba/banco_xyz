# ==============================
# Data (CUIDADO: manter estrutura, ignorar conteúdo pesado)
# ==============================

# Ignora tudo dentro de data
data/*

# Mas mantém estrutura e arquivos importantes
!data/.gitkeep
!data/mock_clients.json

# Mantém estrutura das pastas
!data/corpus/
!data/corpus/.gitkeep

!data/vector_store/
!data/vector_store/.gitkeep

!data/reports/
!data/reports/.gitkeep

!data/raw/
!data/raw/.gitkeep

# ==============================
# FAISS / Vector store pesado
# ==============================
data/vector_store/*.faiss
data/vector_store/*.pkl

# ==============================
# PDFs gerados
# ==============================
data/reports/*.pdf

